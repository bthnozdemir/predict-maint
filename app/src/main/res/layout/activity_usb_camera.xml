<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120">

    <!-- Kamera görüntüsünün çizileceği alan (AUSBC bunu TextureView/AspectRatioTextureView bekliyor) -->
    <com.jiangdg.ausbc.widget.AspectRatioTextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ÜST BAR: Başlık + Geri butonu, kamera görüntüsünün üzerinde yüzer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#800B1120"
        android:padding="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="USB KAMERA"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/txtKameraDurum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text=" BAĞLANIYOR "
            android:textColor="#FFFFFF"
            android:background="#1E293B"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnKameraGeri"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="✕"
            android:textSize="9sp"
            android:backgroundTint="#1E293B"
            android:textColor="#94A3B8" />
    </LinearLayout>

</FrameLayout>
